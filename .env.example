# Copy file này thành .env rồi điền giá trị thật: cp .env.example .env

# PostgreSQL
POSTGRES_DB=babything
POSTGRES_USER=babything
POSTGRES_PASSWORD=change-me

# JWT - chuỗi ngẫu nhiên dài ít nhất 32 ký tự (vd: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# URL người dùng mở trên trình duyệt, dùng để tạo link đặt lại mật khẩu trong email
APP_FRONTEND_URL=http://localhost

# Đăng nhập có bắt nhập OTP gửi qua email không (MFA)
# false -> đăng nhập chỉ cần email + mật khẩu
LOGIN_OTP_ENABLED=true

# Đăng nhập Google - để trống thì ẩn nút Google
# Tạo OAuth client (loại "Web application") tại https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost (Docker) và http://localhost:3000 (npm run dev)
GOOGLE_CLIENT_ID=

# Cloudflare R2 — upload avatar trên profile (để trống = ẩn nút upload)
# Tạo bucket + API token (Object Read & Write) trong Cloudflare Dashboard -> R2
# R2_ACCOUNT_ID: ID tài khoản Cloudflare (Overview hoặc URL dashboard)
# R2_PUBLIC_URL: URL public tới object (Public bucket / custom domain / *.r2.dev), không có dấu / ở cuối
# Bucket cần cho phép đọc public (hoặc gắn custom domain) để trình duyệt load ảnh avatar
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (SMTP)
# MAIL_ENABLED=false -> không gửi mail, chỉ in nội dung email (OTP, link reset) ra log của container api
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=your-email@example.com
